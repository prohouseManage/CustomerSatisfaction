{
  "name": "house-of-training-satisfaction",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "tsx tests/browser.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/prisma.ts migrate deploy",
    "db:admin": "tsx scripts/create-admin.ts",
    "db:check": "tsx scripts/check-database.ts",
    "check:login": "tsx scripts/verify-live-login.ts --existing",
    "email:test": "tsx scripts/test-email.ts",
    "email:test:send": "tsx scripts/test-email.ts --send-test",
    "email:preview": "tsx scripts/preview-email.ts",
    "powerautomate:config": "node scripts/configure-powerautomate.mjs",
    "powerautomate:test": "tsx scripts/test-powerautomate.ts --send-test",
    "odoo:prepare": "tsx scripts/test-odoo.ts --prepare",
    "odoo:test": "tsx scripts/test-odoo.ts --send-test",
    "sessions:cleanup": "tsx scripts/cleanup-archived-sessions.ts",
    "sessions:cleanup:apply": "tsx scripts/cleanup-archived-sessions.ts --apply",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@next/env": "^16.0.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "1.1.2",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "next-auth": "^4.24.13",
    "nodemailer": "^10.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "nodemailer": "$nodemailer"
  }
}
