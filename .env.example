# Supabase transaction pooler (application), always use TLS
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# The public Supabase key is optional here: Prisma uses PostgreSQL, not the REST API.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
# Supabase session pooler or direct connection (migrations)
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""
TOKEN_ENCRYPTION_KEY=""
POWER_AUTOMATE_WEBHOOK_URL=""
POWER_AUTOMATE_WEBHOOK_SECRET=""
POWER_AUTOMATE_INBOUND_SECRET=""
# Legacy single-session UAT configuration. New sessions store their Odoo URL in the admin UI.
ODOO_UAT_ENABLED="false"
ODOO_UAT_SOURCE_SESSION_ID="203238"
ODOO_UAT_SESSION_ID="203238"
ODOO_UAT_SATISFACTION_URL=""
ODOO_UAT_SESSION_NAME=""
ODOO_UAT_TRAINER=""
CRON_SECRET=""
# Invitations de satisfaction : connexion Mailgun distincte du SMTP Supabase Auth.
# Europe : smtp.eu.mailgun.org ; US : smtp.mailgun.org. TLS obligatoire.
SMTP_HOST="smtp.eu.mailgun.org"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
# Mailgun > Settings > API Security > HTTP webhook signing key (not SMTP password/API key).
# POST webhook: https://YOUR_APP/api/webhook/mailgun
MAILGUN_WEBHOOK_SIGNING_KEY=""
# Used only by npm run db:admin; never exposed to the browser
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrateur"
# Demo is always disabled when NODE_ENV=production unless explicitly enabled
ENABLE_DEMO="false"
